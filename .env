# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/fleet_control_db"
DB_NAME=fleet_control_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Chave Secreta para JWT
JWT_SECRET=minha_chave_secreta_muito_segura_para_desenvolvimento_123456

# URL do Frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Configurações de Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Configurações de Upload (opcional)
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Log
LOG_LEVEL=info
